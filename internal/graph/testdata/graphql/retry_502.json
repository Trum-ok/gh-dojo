{
  "comment": "A 502 from GitHub's front end (HTML body, as api.github.com sends it), then success.",
  "handcrafted": true,
  "interactions": [
    {
      "operation": "Viewer",
      "query": "query Viewer { viewer { login } }",
      "status": 502,
      "headers": {
        "Content-Type": "text/html"
      },
      "response": "<html><body><h1>502 Bad Gateway</h1></body></html>"
    },
    {
      "operation": "Viewer",
      "query": "query Viewer { viewer { login } }",
      "response": {
        "data": {
          "viewer": {
            "login": "Trum-ok"
          }
        }
      }
    }
  ]
}
