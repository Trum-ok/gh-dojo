file: .github/dojo.toml
version: 1
preset: "kanban"
board: owner=Trum-ok project=1 repos=[]
fields.status: "Status"
statuses: initial="Backlog" final=["Done"]
labels: types=[] area_prefix="area:"
session: env=[] link="{id}"
verb start
  when: You begin working on the issue
  to: "In progress"
  from: ["Backlog" "Waiting" "Ready"]
  require: [] require_one_of: []
  comment: "Started. Session: {session}\n\n{comment}"
verb wait
  when: Work is stuck: waiting for another issue or an outside decision
  to: "Waiting"
  from: ["In progress"]
  require: [] require_one_of: ["by" "comment"]
  comment: "Waiting for {by}.\n\n{comment}"
verb ready
  when: The work is done, verified and committed, but not released yet
  to: "Ready"
  from: ["In progress" "Waiting"]
  require: [] require_one_of: []
  comment: "{comment}"
status refs:
  "Backlog"    statuses.initial (from preset kanban)
  "Done"       statuses.final (from preset kanban)
  "In progress" verbs.start.to (from preset kanban)
  "Backlog"    verbs.start.from (from preset kanban)
  "Waiting"    verbs.start.from (from preset kanban)
  "Ready"      verbs.start.from (from preset kanban)
  "Waiting"    verbs.wait.to (from preset kanban)
  "In progress" verbs.wait.from (from preset kanban)
  "Ready"      verbs.ready.to (from preset kanban)
  "In progress" verbs.ready.from (from preset kanban)
  "Waiting"    verbs.ready.from (from preset kanban)
