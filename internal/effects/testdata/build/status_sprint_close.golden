mutation Verb($project: ID!, $item: ID!, $field: ID!, $option: String!, $sprintField: ID!, $iteration: String!, $issue: ID!, $reason: IssueClosedStateReason!) {
  status: updateProjectV2ItemFieldValue(input: {projectId: $project, itemId: $item, fieldId: $field, value: {singleSelectOptionId: $option}}) { projectV2Item { id } }
  sprint: updateProjectV2ItemFieldValue(input: {projectId: $project, itemId: $item, fieldId: $sprintField, value: {iterationId: $iteration}}) { projectV2Item { id } }
  close: closeIssue(input: {issueId: $issue, stateReason: $reason}) { issue { id } }
}
