mutation Verb($project: ID!, $item: ID!, $field: ID!, $option: String!, $issue: ID!, $blocker0: ID!, $blocker1: ID!, $body: String!) {
  status: updateProjectV2ItemFieldValue(input: {projectId: $project, itemId: $item, fieldId: $field, value: {singleSelectOptionId: $option}}) { projectV2Item { id } }
  blockedBy0: addBlockedBy(input: {issueId: $issue, blockingIssueId: $blocker0}) { issue { id } }
  blockedBy1: addBlockedBy(input: {issueId: $issue, blockingIssueId: $blocker1}) { issue { id } }
  comment: addComment(input: {subjectId: $issue, body: $body}) { commentEdge { node { id } } }
}
--- vars
{
  "blocker0": "I_12",
  "blocker1": "I_7",
  "body": "Started.\n\n<!-- gh-dojo:start:995a443b -->",
  "field": "PVTSSF_1",
  "issue": "I_1",
  "item": "PVTI_1",
  "option": "47fc9ee4",
  "project": "PVT_1"
}
--- steps
status, blockedBy0, blockedBy1, comment
