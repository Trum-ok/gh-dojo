mutation Verb($project: ID!, $item: ID!, $issue: ID!, $field: ID!, $option: String!, $addLabels: [ID!]!, $removeLabels: [ID!]!, $assignees: [ID!]!, $body: String!) {
  unarchive: unarchiveProjectV2Item(input: {projectId: $project, itemId: $item}) { item { id } }
  reopen: reopenIssue(input: {issueId: $issue}) { issue { id } }
  status: updateProjectV2ItemFieldValue(input: {projectId: $project, itemId: $item, fieldId: $field, value: {singleSelectOptionId: $option}}) { projectV2Item { id } }
  addLabels: addLabelsToLabelable(input: {labelableId: $issue, labelIds: $addLabels}) { clientMutationId }
  removeLabels: removeLabelsFromLabelable(input: {labelableId: $issue, labelIds: $removeLabels}) { clientMutationId }
  assign: addAssigneesToAssignable(input: {assignableId: $issue, assigneeIds: $assignees}) { clientMutationId }
  comment: addComment(input: {subjectId: $issue, body: $body}) { commentEdge { node { id } } }
}
