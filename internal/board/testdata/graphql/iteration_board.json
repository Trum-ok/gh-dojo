{
  "comment": "Organization board with an iteration field. Shape follows the recorded org_board.json plus ProjectV2IterationField.configuration from the GraphQL schema; IDs are made up. Status has the sprints preset's statuses (Backlog, In progress, Waiting, Ready, Done) and Todo; Priority and Estimate are for the field effect; Ready for iteration = \"by_status_date:Ready\".",
  "handcrafted": true,
  "interactions": [
    {
      "operation": "BoardSchema",
      "query": "query BoardSchema($owner: String!, $number: Int!) {\n  repositoryOwner(login: $owner) {\n    __typename\n    login\n    ... on User { projectV2(number: $number) { ...board } }\n    ... on Organization { projectV2(number: $number) { ...board } }\n  }\n}\n\nfragment board on ProjectV2 {\n  id\n  title\n  url\n  closed\n  fields(first: 100) {\n    nodes {\n      ... on ProjectV2FieldCommon { id name dataType }\n      ... on ProjectV2SingleSelectField { options { id name } }\n      ... on ProjectV2IterationField {\n        configuration {\n          iterations { id title startDate duration }\n          completedIterations { id title startDate duration }\n        }\n      }\n    }\n  }\n}",
