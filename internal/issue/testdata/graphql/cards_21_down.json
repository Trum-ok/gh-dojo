      "operation": "IssueCards",
      "query": "query IssueCards($owner: String!, $repo: String!, $comments: Int!, $status: String!, $n0: Int!, $n1: Int!, $n2: Int!, $n3: Int!, $n4: Int!, $n5: Int!, $n6: Int!, $n7: Int!, $n8: Int!, $n9: Int!, $n10: Int!, $n11: Int!, $n12: Int!, $n13: Int!, $n14: Int!, $n15: Int!, $n16: Int!, $n17: Int!, $n18: Int!, $n19: Int!) {\n  repository(owner: $owner, name: $repo) {\n    i0: issueOrPullRequest(number: $n0) { ...card }\n    i1: issueOrPullRequest(number: $n1) { ...card }\n    i2: issueOrPullRequest(number: $n2) { ...card }\n    i3: issueOrPullRequest(number: $n3) { ...card }\n    i4: issueOrPullRequest(number: $n4) { ...card }\n    i5: issueOrPullRequest(number: $n5) { ...card }\n    i6: issueOrPullRequest(number: $n6) { ...card }\n    i7: issueOrPullRequest(number: $n7) { ...card }\n    i8: issueOrPullRequest(number: $n8) { ...card }\n    i9: issueOrPullRequest(number: $n9) { ...card }\n    i10: issueOrPullRequest(number: $n10) { ...card }\n    i11: issueOrPullRequest(number: $n11) { ...card }\n    i12: issueOrPullRequest(number: $n12) { ...card }\n    i13: issueOrPullRequest(number: $n13) { ...card }\n    i14: issueOrPullRequest(number: $n14) { ...card }\n    i15: issueOrPullRequest(number: $n15) { ...card }\n    i16: issueOrPullRequest(number: $n16) { ...card }\n    i17: issueOrPullRequest(number: $n17) { ...card }\n    i18: issueOrPullRequest(number: $n18) { ...card }\n    i19: issueOrPullRequest(number: $n19) { ...card }\n  }\n}\n\nfragment card on IssueOrPullRequest {\n      __typename\n      ... on Issue {\n        id\n        number\n        title\n        state\n        stateReason(enableDuplicate: true)\n        url\n        createdAt\n        closedAt\n        author { login }\n        body\n        milestone { title dueOn }\n        labels(first: 20) { totalCount nodes { name } }\n        assignees(first: 10) { totalCount nodes { login } }\n        comments(last: $comments) {\n          totalCount\n          nodes { id author { login } createdAt viewerDidAuthor body }\n        }\n        blockedBy(first: 20) { totalCount nodes { ...link } }\n        blocking(first: 20) { totalCount nodes { ...link } }\n        projectItems(first: 20) {\n          totalCount\n          nodes {\n            id\n            isArchived\n            createdAt\n            project { id }\n            status: fieldValueByName(name: $status) { ...value }\n            fieldValues(first: 100) { totalCount nodes { ...value } }\n          }\n        }\n        timelineItems(last: 20, itemTypes: [PROJECT_V2_ITEM_STATUS_CHANGED_EVENT]) {\n          totalCount\n          nodes {\n            ... on ProjectV2ItemStatusChangedEvent {\n              createdAt\n              previousStatus\n              status\n              wasAutomated\n              actor { login }\n              project { id }\n            }\n          }\n        }\n      }\n    }\nfragment link on Issue {\n  number\n  title\n  state\n  repository { nameWithOwner }\n  projectItems(first: 10) {\n    nodes {\n      project { id }\n      status: fieldValueByName(name: $status) {\n        ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2FieldCommon { id } } }\n      }\n    }\n  }\n}\n\nfragment value on ProjectV2ItemFieldValue {\n  __typename\n  ... on ProjectV2ItemFieldSingleSelectValue { name optionId field { ...field } }\n  ... on ProjectV2ItemFieldIterationValue { title iterationId startDate duration field { ...field } }\n  ... on ProjectV2ItemFieldTextValue { text field { ...field } }\n  ... on ProjectV2ItemFieldNumberValue { number field { ...field } }\n  ... on ProjectV2ItemFieldDateValue { date field { ...field } }\n}\n\nfragment field on ProjectV2FieldCommon { id name dataType }",
