      "query": "query IssueCard($owner: String!, $repo: String!, $number: Int!, $comments: Int!, $status: String!, $link0Owner: String!, $link0Repo: String!, $link0Number: Int!, $link1Owner: String!, $link1Repo: String!, $link1Number: Int!, $link2Owner: String!, $link2Repo: String!, $link2Number: Int!, $link3Owner: String!, $link3Repo: String!, $link3Number: Int!) {\n  repository(owner: $owner, name: $repo) {\n    issueOrPullRequest(number: $number) {\n      __typename\n      ... on Issue {\n        id\n        number\n        title\n        state\n        stateReason(enableDuplicate: true)\n        url\n        createdAt\n        closedAt\n        author { login }\n        body\n        milestone { title dueOn }\n        labels(first: 20) { totalCount nodes { name } }\n        assignees(first: 10) { totalCount nodes { login } }\n        comments(last: $comments) {\n          totalCount\n          nodes { id author { login } createdAt viewerDidAuthor body }\n        }\n        blockedBy(first: 20) { totalCount nodes { ...link } }\n        blocking(first: 20) { totalCount nodes { ...link } }\n        parent { ...link }\n        subIssues(first: 20) { totalCount nodes { ...link } }\n        subIssuesSummary { total completed }\n        projectItems(first: 20) {\n          totalCount\n          nodes {\n            id\n            isArchived\n            createdAt\n            project { id }\n            status: fieldValueByName(name: $status) { ...value }\n            fieldValues(first: 100) { totalCount nodes { ...value } }\n          }\n        }\n        timelineItems(last: 20, itemTypes: [PROJECT_V2_ITEM_STATUS_CHANGED_EVENT]) {\n          totalCount\n          nodes {\n            ... on ProjectV2ItemStatusChangedEvent {\n              createdAt\n              previousStatus\n              status\n              wasAutomated\n              actor { login }\n              project { id }\n            }\n          }\n        }\n      }\n    }\n  }\n  link0: repository(owner: $link0Owner, name: $link0Repo) {\n    nameWithOwner\n    issueOrPullRequest(number: $link0Number) { __typename ... on Issue { id title state blocking(first: 50) { nodes { id } } blockedBy(first: 50) { nodes { id } } } }\n  }\n  link1: repository(owner: $link1Owner, name: $link1Repo) {\n    nameWithOwner\n    issueOrPullRequest(number: $link1Number) { __typename ... on Issue { id title state blocking(first: 50) { nodes { id } } blockedBy(first: 50) { nodes { id } } } }\n  }\n  link2: repository(owner: $link2Owner, name: $link2Repo) {\n    nameWithOwner\n    issueOrPullRequest(number: $link2Number) { __typename ... on Issue { id title state blocking(first: 50) { nodes { id } } blockedBy(first: 50) { nodes { id } } } }\n  }\n  link3: repository(owner: $link3Owner, name: $link3Repo) {\n    nameWithOwner\n    issueOrPullRequest(number: $link3Number) { __typename ... on Issue { id title state blocking(first: 50) { nodes { id } } blockedBy(first: 50) { nodes { id } } } }\n  }\n}\n\nfragment link on Issue {\n  number\n  title\n  state\n  repository { nameWithOwner }\n  projectItems(first: 10) {\n    totalCount\n    nodes {\n      isArchived\n      project { id }\n      status: fieldValueByName(name: $status) {\n        ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2FieldCommon { id } } }\n      }\n    }\n  }\n}\n\nfragment value on ProjectV2ItemFieldValue {\n  __typename\n  ... on ProjectV2ItemFieldSingleSelectValue { name field { ...field } }\n  ... on ProjectV2ItemFieldIterationValue { title iterationId startDate duration field { ...field } }\n  ... on ProjectV2ItemFieldTextValue { text field { ...field } }\n  ... on ProjectV2ItemFieldNumberValue { number field { ...field } }\n  ... on ProjectV2ItemFieldDateValue { date field { ...field } }\n}\n\nfragment field on ProjectV2FieldCommon { id name dataType }",
