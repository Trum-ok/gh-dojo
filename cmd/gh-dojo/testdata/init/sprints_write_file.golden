# gh-dojo: the board and the process verbs of this repository.
# Format and keys: https://github.com/Trum-ok/gh-dojo/blob/main/docs/configuration.md
# Preset sprints brings the verbs, statuses and fields; override any of
# them below, e.g. [verbs.start] when = "..." in your project's language.
# gh dojo --help shows the verbs this file gives.

version = 1
preset = "sprints"

[board]
owner = "acme"
project = 3  # Shop
repos = ["acme/shop"]  # the first one is the default repository
