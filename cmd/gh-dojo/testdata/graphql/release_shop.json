{
  "comment": "Hand-crafted like internal/release/testdata/graphql/history_dojo.json, for the fake backend's acme/shop: gh dojo release HEAD --since abc1234 reads the history down to it. Fixes #42 and #43; Closes #5, a pull request; one commit names nothing.",
  "handcrafted": true,
  "interactions": [
    {
      "operation": "ReleaseSince",
      "query": "query ReleaseSince($owner: String!, $repo: String!, $head: String!, $since: String!, $sinceRef: String!) {\n  repository(owner: $owner, name: $repo) {\n    head: object(expression: $head) { oid }\n    since: object(expression: $since) { oid }\n    sinceRef: ref(qualifiedName: $sinceRef) { prefix name }\n  }\n}",
      "variables": {
        "head": "HEAD^{commit}",
        "owner": "acme",
        "repo": "shop",
        "since": "abc1234^{commit}",
        "sinceRef": "abc1234"
      },
      "repeat": true,
      "response": {
        "data": {
          "repository": {
            "head": {
              "oid": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
            },
            "since": {
              "oid": "abababababababababababababababababababab"
            },
            "sinceRef": null
          }
        }
      }
    },
    {
      "operation": "ReleaseHistory",
      "query": "query ReleaseHistory($owner: String!, $repo: String!, $head: GitObjectID!, $cursor: String) {\n  repository(owner: $owner, name: $repo) {\n    object(oid: $head) {\n      ... on Commit {\n        history(first: 100, after: $cursor) {\n          pageInfo { hasNextPage endCursor }\n          nodes { ...releaseCommit }\n        }\n      }\n    }\n  }\n}\n\n\n\nfragment releaseCommit on Commit {\n  oid\n  message\n  associatedPullRequests(first: 5) {\n    totalCount\n    nodes {\n      number\n      merged\n      repository { nameWithOwner }\n      closingIssuesReferences(first: 25) {\n        totalCount\n        nodes { number repository { nameWithOwner } }\n      }\n    }\n  }\n}",
      "variables": {
        "cursor": null,
        "head": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "owner": "acme",
        "repo": "shop"
      },
      "repeat": true,
      "response": {
        "data": {
          "repository": {
            "object": {
              "history": {
                "totalCount": 6,
                "pageInfo": {
                  "hasNextPage": false,
                  "endCursor": "end"
                },
                "nodes": [
                  {
                    "oid": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
                    "message": "Fix the login redirect\n\nFixes #42",
                    "associatedPullRequests": {
                      "totalCount": 0,
                      "nodes": []
                    }
                  },
                  {
                    "oid": "1212121212121212121212121212121212121212",
                    "message": "Revert the cache\n\nCloses #5",
                    "associatedPullRequests": {
                      "totalCount": 0,
                      "nodes": []
                    }
                  },
                  {
                    "oid": "1313131313131313131313131313131313131313",
                    "message": "Speed up checkout, fixes #43",
                    "associatedPullRequests": {
                      "totalCount": 0,
                      "nodes": []
                    }
                  },
                  {
                    "oid": "1414141414141414141414141414141414141414",
                    "message": "Bump dependencies",
                    "associatedPullRequests": {
                      "totalCount": 0,
                      "nodes": []
                    }
                  },
                  {
                    "oid": "abababababababababababababababababababab",
                    "message": "Release v0.9.0",
                    "associatedPullRequests": {
