{
  "comment": "Hand-crafted: doctor with labels.type_prefix = \"type: \" and labels.area_prefix = \"service:\" on two repositories. The Doctor answer is made up as in doctor_ok.json; in DoctorLabels, repo0 is the real API's answer for Trum-ok/gh-dojo, saved by hand (no type: and no service: label), and repo1, Trum-ok/gh-dojo-site, is made up: three type: and three service: labels, one of each in another case.",
  "handcrafted": true,
  "interactions": [
    {
      "operation": "Doctor",
      "query": "query Doctor($owner0: String!, $name0: String!, $owner1: String!, $name1: String!) {\n  viewer { login }\n  repo0: repository(owner: $owner0, name: $name0) { nameWithOwner hasIssuesEnabled }\n  repo1: repository(owner: $owner1, name: $name1) { nameWithOwner hasIssuesEnabled }\n}",
      "variables": {
        "owner0": "Trum-ok",
        "name0": "gh-dojo",
        "owner1": "Trum-ok",
        "name1": "gh-dojo-site"
      },
      "headers": {
        "X-OAuth-Scopes": "gist, project, read:org, repo"
      },
      "response": {
        "data": {
          "viewer": {
            "login": "Trum-ok"
          },
          "repo0": {
            "nameWithOwner": "Trum-ok/gh-dojo",
            "hasIssuesEnabled": true
          },
          "repo1": {
            "nameWithOwner": "Trum-ok/gh-dojo-site",
            "hasIssuesEnabled": true
          }
        }
      }
    },
    {
      "operation": "DoctorLabels",
      "query": "query DoctorLabels($owner0: String!, $name0: String!, $owner1: String!, $name1: String!, $type: String!, $area: String!) {\n  repo0: repository(owner: $owner0, name: $name0) {\n    labels(first: 100) { totalCount nodes { name } }\n    type: labels(first: 100, query: $type) { nodes { name } }\n    area: labels(first: 100, query: $area) { nodes { name } }\n  }\n  repo1: repository(owner: $owner1, name: $name1) {\n    labels(first: 100) { totalCount nodes { name } }\n    type: labels(first: 100, query: $type) { nodes { name } }\n    area: labels(first: 100, query: $area) { nodes { name } }\n  }\n}",
      "variables": {
        "owner0": "Trum-ok",
        "name0": "gh-dojo",
        "owner1": "Trum-ok",
        "name1": "gh-dojo-site",
        "type": "type: ",
        "area": "service:"
      },
      "response": {
        "data": {
          "repo0": {
