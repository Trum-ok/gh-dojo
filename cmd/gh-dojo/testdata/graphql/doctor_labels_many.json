{
  "comment": "Hand-crafted: doctor with labels.type_prefix = \"kind/\" and the kanban preset's area prefix on three made-up repositories with over 100 labels each; the shapes follow doctor_labels.json. Search also returns labels that only contain the prefix (needs kind/triage), which doctor does not count.",
  "handcrafted": true,
  "interactions": [
    {
      "operation": "Doctor",
      "query": "query Doctor($owner0: String!, $name0: String!, $owner1: String!, $name1: String!, $owner2: String!, $name2: String!) {\n  viewer { login }\n  repo0: repository(owner: $owner0, name: $name0) { nameWithOwner hasIssuesEnabled }\n  repo1: repository(owner: $owner1, name: $name1) { nameWithOwner hasIssuesEnabled }\n  repo2: repository(owner: $owner2, name: $name2) { nameWithOwner hasIssuesEnabled }\n}",
      "variables": {
        "owner0": "Trum-ok",
        "name0": "big",
        "owner1": "Trum-ok",
        "name1": "huge",
        "owner2": "Trum-ok",
        "name2": "paged"
      },
      "headers": {
        "X-OAuth-Scopes": "gist, project, read:org, repo"
      },
      "response": {
        "data": {
          "viewer": {
            "login": "Trum-ok"
          },
          "repo0": {
            "nameWithOwner": "Trum-ok/big",
            "hasIssuesEnabled": true
          },
          "repo1": {
            "nameWithOwner": "Trum-ok/huge",
            "hasIssuesEnabled": true
          },
          "repo2": {
            "nameWithOwner": "Trum-ok/paged",
            "hasIssuesEnabled": true
          }
        }
      }
    },
